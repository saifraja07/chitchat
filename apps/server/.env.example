# development | staging | production
# In production, CORS_ORIGINS and REDIS_URL become required (the app
# fails fast at startup if either is missing) — see config/env.js.
NODE_ENV=development

PORT=4000

# Comma-separated list of allowed frontend origins.
# Defaults (if unset) cover local dev on both localhost and 127.0.0.1 —
# browsers treat these as different origins even for the same machine.
# In production, set this to your actual frontend origin(s), e.g.
# CORS_ORIGINS=https://relay.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Redis connection string. Required in production. Supports auth via
# redis://:password@host:port and TLS via rediss://...
REDIS_URL=redis://127.0.0.1:6379
REDIS_CONNECT_TIMEOUT_MS=5000

# --- HTTP-level protections (Express) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
REQUEST_BODY_LIMIT=10kb

SHUTDOWN_TIMEOUT_MS=10000

# --- Matchmaking (Redis TTLs) ---
# Backstop only — normal cleanup happens explicitly on leave/next/disconnect.
# Room TTL is refreshed on every heartbeat while a session has an active
# room, so a long-running call/chat never has its room silently expire.
QUEUE_MEMBER_TTL_SECONDS=120
ROOM_TTL_SECONDS=21600

# --- Chat message rate limiting (per socket) ---
CHAT_RATE_LIMIT_WINDOW_MS=10000
CHAT_RATE_LIMIT_MAX=15

# --- Matchmaking action rate limiting (queue:join / match:next / match:leave, per socket) ---
MATCH_ACTION_RATE_LIMIT_WINDOW_MS=10000
MATCH_ACTION_RATE_LIMIT_MAX=20

# --- WebRTC signaling rate limiting (per socket) ---
# offer/answer are rare (~1-2 per call); ICE candidates are frequent
# during connection setup, so they get a separate, higher allowance.
WEBRTC_SIGNAL_RATE_LIMIT_WINDOW_MS=10000
WEBRTC_SIGNAL_RATE_LIMIT_MAX=20

# --- Per-IP connection limiting ---
# Process-local soft guard against one address flooding the server with
# connections. Not a substitute for a real WAF/reverse-proxy rate limit
# in front of a production deployment — see README "Known limitations".
IP_CONNECT_RATE_WINDOW_MS=60000
IP_CONNECT_RATE_MAX=30
IP_CONNECT_MAX_CONCURRENT=20

# --- WebRTC ICE servers ---
# STUN URLs are public information — safe as static comma-separated config.
STUN_URLS=stun:stun.l.google.com:19302

# TURN is optional but recommended for production: without it, calls
# between peers behind symmetric NATs or restrictive firewalls may fail
# to connect at all. If set, the server mints a fresh, short-lived
# username/credential pair per connection using the standard coturn
# "use-auth-secret" REST-API-style HMAC scheme — TURN_SHARED_SECRET
# itself is NEVER sent to any client. Leave both unset to run STUN-only
# (same behavior as before this was added).
#
# TURN_URLS is comma-separated and can include multiple transports for
# the same server, e.g.:
#   TURN_URLS=turn:turn.example.com:3478,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349
# TURN_SHARED_SECRET must match the `static-auth-secret` configured on
# the TURN server (e.g. coturn's `static-auth-secret` in turnserver.conf
# with `use-auth-secret` enabled).
TURN_URLS=
TURN_SHARED_SECRET=
# How long a minted TURN credential remains valid. Credentials are
# minted once per socket connection and reused for that connection's
# lifetime (including across multiple matches/Next clicks) — a call
# that outlives this window would need to reconnect. 3600 (1h) covers
# any realistic single session; raise it if that assumption is wrong
# for your deployment.
TURN_CREDENTIAL_TTL_SECONDS=3600
