# URL of the backend Socket.IO server
VITE_SOCKET_URL=http://localhost:4000

# development | staging | production
VITE_APP_ENV=development

# Note: there is no VITE_ICE_SERVERS. ICE server configuration (STUN,
# and a short-lived TURN credential if the backend has TURN configured)
# is sent by the server over Socket.IO right after connecting, not
# baked into the client build — TURN credentials must never be static
# values shipped in a build artifact. See the server's .env.example
# for STUN_URLS / TURN_URLS / TURN_SHARED_SECRET.
